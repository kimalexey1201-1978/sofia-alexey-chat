{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/schemas/reconciliation-decision.v1.schema.json",
  "title": "Sofia Reconciliation Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "taskId",
    "requestId",
    "taskVersionBefore",
    "taskVersionAfter",
    "conclusion",
    "reasonCode",
    "evidenceSetDigest",
    "policyVersion",
    "decidedAt"
  ],
  "properties": {
    "decisionId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "taskVersionBefore": {
      "type": "integer",
      "minimum": 1
    },
    "taskVersionAfter": {
      "type": "integer",
      "minimum": 1
    },
    "conclusion": {
      "type": "string",
      "enum": [
        "CONFIRMED_APPLIED",
        "CONFIRMED_NOT_APPLIED",
        "STILL_UNKNOWN"
      ]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "evidenceSetDigest": {
      "type": "string",
      "minLength": 1
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
