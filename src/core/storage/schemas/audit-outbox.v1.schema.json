{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/schemas/audit-outbox.v1.schema.json",
  "title": "Sofia Audit Outbox Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "aggregateId",
    "aggregateVersion",
    "eventType",
    "payload",
    "createdAt",
    "deliveryState",
    "attemptCount"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "deliveryState": {
      "type": "string",
      "enum": [
        "pending",
        "delivered"
      ]
    },
    "attemptCount": {
      "type": "integer",
      "minimum": 0
    },
    "deliveredAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
