{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/data-classification.schema.json",
  "title": "Sofia AI Data Classification",
  "description": "Classification and provenance metadata for a data object; classification may only become less restrictive through an approved declassification policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_id", "classification", "source", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "data_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "classification": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
    "source": { "type": "string", "enum": ["user_input", "conversation_history", "device_sensor", "external_service", "system_generated", "imported_data"] },
    "purpose_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "owner_principal_id": { "type": "string", "maxLength": 200 },
    "created_at": { "type": "string", "format": "date-time" },
    "provenance_ref": { "type": "string", "maxLength": 1000 },
    "declassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "approved_by", "approved_at", "reason"],
      "properties": {
        "policy_id": { "type": "string", "maxLength": 160 },
        "approved_by": { "type": "string", "maxLength": 200 },
        "approved_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}