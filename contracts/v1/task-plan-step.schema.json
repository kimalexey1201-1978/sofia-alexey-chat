{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.example/contracts/v1/task-plan-step.schema.json",
  "title": "Sofia AI Task Plan Step v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "description",
    "step_type",
    "depends_on",
    "required_capabilities",
    "risk_tier",
    "data_classification",
    "status",
    "verification_criteria"
  ],
  "properties": {
    "step_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "step_type": { "enum": ["reason", "retrieve", "read", "transform", "create", "execute", "communicate", "verify", "wait", "owner_decision"] },
    "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 128 } },
    "required_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 180 } },
    "candidate_executor_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 256 } },
    "input_refs": { "type": "array", "items": { "type": "string", "maxLength": 512 } },
    "output_schema_ref": { "type": "string", "maxLength": 256 },
    "target_ref": { "type": "string", "maxLength": 512 },
    "risk_tier": { "enum": ["R0", "R1", "R2", "R3", "unknown"] },
    "data_classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "purpose_id": { "type": "string", "maxLength": 160 },
    "external_processor_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 256 } },
    "estimated_cost_minor_units": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "estimated_duration_seconds": { "type": "integer", "minimum": 0 },
    "owner_approval_gate": { "type": "boolean" },
    "approval_scope_ref": { "type": "string", "maxLength": 256 },
    "idempotency_required": { "type": "boolean" },
    "verification_criteria": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "maxLength": 1000 } },
    "status": { "enum": ["pending", "ready", "running", "blocked", "verifying", "succeeded", "failed", "cancelled", "outcome_unknown", "skipped"] }
  }
}
