{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/environment-state-observation.schema.json",
  "title": "Environment State Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "device_id", "observed_at", "source", "state", "freshness", "confidence", "data_classification"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "observation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "observed_at": {"type": "string", "format": "date-time"},
    "source": {"enum": ["device_report", "hub_report", "sensor", "user_input", "provider_cache"]},
    "state": {"type": "object", "minProperties": 1, "maxProperties": 50, "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}},
    "units": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 32}},
    "freshness": {"enum": ["fresh", "stale", "delayed", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "quality_notes": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 20},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 120},
    "consent_ref": {"type": "string", "maxLength": 200},
    "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]}
  }
}
