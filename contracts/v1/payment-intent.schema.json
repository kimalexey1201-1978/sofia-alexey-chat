{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/payment-intent.schema.json",
  "title": "Sofia Payment Intent",
  "description": "Prepared payment request bound to exact parameters; it is not itself authorization or execution.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["payment_intent_id", "source_account_ref", "payee_ref", "amount", "currency", "purpose", "status", "requested_at", "authority_envelope_ref", "policy_decision_ref"],
  "properties": {
    "payment_intent_id": { "type": "string", "format": "uuid" },
    "source_account_ref": { "type": "string", "maxLength": 256 },
    "payee_ref": { "type": "string", "maxLength": 256 },
    "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$", "maxLength": 40 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "fee_amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$", "maxLength": 40 },
    "execution_at": { "type": "string", "format": "date-time" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "type": "string", "enum": ["draft", "awaiting_confirmation", "approved", "submitted", "processing", "settled", "rejected", "cancelled", "reversed", "completion_unknown"] },
    "authority_envelope_ref": { "type": "string", "maxLength": 256 },
    "policy_decision_ref": { "type": "string", "maxLength": 256 },
    "approval_ref": { "type": "string", "maxLength": 256 },
    "idempotency_key": { "type": "string", "maxLength": 256 },
    "provider_transaction_ref": { "type": "string", "maxLength": 256 },
    "parameter_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "requested_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
