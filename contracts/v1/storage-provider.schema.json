{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/storage-provider.schema.json",
  "title": "Sofia Storage Provider",
  "description": "Provider-neutral connection and capability record for local, removable, network, or cloud storage.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_id", "provider_type", "display_name", "status", "capabilities", "authorization_state", "created_at"],
  "properties": {
    "provider_id": { "type": "string", "minLength": 8, "maxLength": 160 },
    "provider_type": { "type": "string", "enum": ["android_media_store", "android_saf", "google_drive", "cloud_object_storage", "network_share", "removable_storage", "other"] },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "status": { "type": "string", "enum": ["discovered", "connecting", "connected", "degraded", "disconnected", "revoked", "error"] },
    "authorization_state": { "type": "string", "enum": ["not_requested", "pending", "authorized", "expired", "revoked", "denied"] },
    "account_ref": { "type": "string", "maxLength": 256 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["list", "read", "write", "create_container", "delete", "trash", "checksum", "resumable_upload", "resumable_download", "quota", "restore"] }
    },
    "quota_bytes": { "type": "integer", "minimum": 0 },
    "used_bytes": { "type": "integer", "minimum": 0 },
    "available_bytes": { "type": "integer", "minimum": 0 },
    "provider_metadata": { "type": "object", "maxProperties": 32 },
    "last_verified_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "connected" } }, "required": ["status"] },
      "then": { "properties": { "authorization_state": { "const": "authorized" } }, "required": ["authorization_state"] }
    },
    {
      "if": { "required": ["quota_bytes", "used_bytes"], "properties": { "quota_bytes": { "type": "integer" }, "used_bytes": { "type": "integer" } } },
      "then": { "properties": { "used_bytes": { "maximum": 9007199254740991 } } }
    }
  ]
}