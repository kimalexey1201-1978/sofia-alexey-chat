{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/message-envelope.schema.json",
  "title": "Sofia AI Inter-Module Message Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "message_id",
    "correlation_id",
    "timestamp",
    "source",
    "target",
    "operation",
    "payload"
  ],
  "properties": {
    "envelope_version": {
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "module_version"
      ],
      "properties": {
        "module_id": {
          "type": "string"
        },
        "module_version": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "capability_id",
        "contract_version"
      ],
      "properties": {
        "module_id": {
          "type": "string"
        },
        "capability_id": {
          "type": "string"
        },
        "contract_version": {
          "type": "string"
        }
      }
    },
    "operation": {
      "enum": [
        "invoke",
        "result",
        "event",
        "cancel"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "permission_grant_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "payload": {
      "type": "object"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        },
        "parent_span_id": {
          "type": "string"
        }
      }
    }
  }
}
