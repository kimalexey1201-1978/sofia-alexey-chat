{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/media-processing-job.schema.json",
  "title": "Sofia Media Processing Job",
  "description": "Bounded request for an authorized media analysis, transformation, edit, or render operation.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "requester_principal_id", "operation", "input_media_asset_ids", "purpose", "requested_at"],
  "properties": {
    "job_id": { "type": "string", "format": "uuid" },
    "requester_principal_id": { "type": "string", "maxLength": 128 },
    "operation": { "type": "string", "enum": ["analyze", "transcode", "trim", "split", "join", "crop", "resize", "rotate", "stabilize", "color_adjust", "audio_mix", "denoise", "transcribe", "subtitle", "translate_subtitles", "render", "thumbnail", "keyframe_extract"] },
    "input_media_asset_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "output_profile_id": { "type": "string", "maxLength": 160 },
    "adapter_id": { "type": "string", "maxLength": 160 },
    "adapter_version": { "type": "string", "maxLength": 64 },
    "parameters": { "type": "object", "maxProperties": 128 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
    "data_classification": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
    "max_runtime_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 107374182400 },
    "max_cost_units": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "require_user_confirmation": { "type": "boolean", "default": false },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
