{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/interaction-preferences.schema.json",
  "title": "Sofia Interaction Preferences",
  "description": "User-controlled defaults for response style and interaction behavior; current explicit instructions take precedence.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "response_language": { "type": "string", "maxLength": 35 },
    "verbosity": { "type": "string", "enum": ["concise", "balanced", "detailed"] },
    "tone": { "type": "string", "enum": ["neutral", "warm", "formal", "casual"] },
    "preferred_name": { "type": "string", "maxLength": 80 },
    "address_style": { "type": "string", "enum": ["none", "first_name", "preferred_term"] },
    "preferred_address_term": { "type": "string", "maxLength": 80 },
    "format_preferences": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["bullets", "tables", "step_by_step", "plain_text", "examples", "summary_first"]
      }
    },
    "proactive_suggestions_enabled": { "type": "boolean", "default": false },
    "confirm_ambiguous_preferences": { "type": "boolean", "default": true }
  }
}
