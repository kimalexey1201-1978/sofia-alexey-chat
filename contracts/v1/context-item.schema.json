{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/context-item.schema.json",
  "title": "Sofia Context Item",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "domain",
    "assertion_kind",
    "epistemic_status",
    "content",
    "source_ref",
    "observed_at",
    "classification",
    "purpose",
    "validity",
    "quality"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "format": "uuid"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "assertion_kind": {
      "type": "string",
      "enum": [
        "observed",
        "owner_stated",
        "externally_reported",
        "derived",
        "inferred",
        "assumed",
        "unknown"
      ]
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "supported",
        "corroborated",
        "verified",
        "unverified",
        "disputed",
        "stale",
        "unknown"
      ]
    },
    "content": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "object",
        "array",
        "null"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_ref": {
      "type": "string",
      "maxLength": 256
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "current",
            "stale",
            "expired",
            "unknown"
          ]
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "freshness_policy_ref": {
          "type": "string",
          "maxLength": 256
        },
        "clock_uncertainty_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "limitations"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "verification_ref": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "lineage_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "transformation_ref": {
      "type": "string",
      "maxLength": 256
    },
    "conflict_group_ref": {
      "type": "string",
      "maxLength": 256
    },
    "retention_class": {
      "type": "string",
      "maxLength": 128
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
