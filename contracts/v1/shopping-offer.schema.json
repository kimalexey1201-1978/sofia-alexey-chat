{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/shopping-offer.schema.json",
  "title": "Sofia Shopping Offer",
  "description": "Time-bound seller offer with price, fees, availability, and source evidence.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["offer_id", "product_id", "seller_name", "item_price", "currency", "source_ref", "observed_at"],
  "properties": {
    "offer_id": { "type": "string", "maxLength": 256 },
    "product_id": { "type": "string", "maxLength": 256 },
    "seller_id": { "type": "string", "maxLength": 256 },
    "seller_name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "item_price": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$", "maxLength": 40 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "shipping_cost": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$", "maxLength": 40 },
    "taxes_and_fees": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$", "maxLength": 40 },
    "total_cost_status": { "type": "string", "enum": ["complete", "partial", "unknown"] },
    "availability": { "type": "string", "enum": ["in_stock", "low_stock", "out_of_stock", "preorder", "unknown"] },
    "delivery_estimate": { "type": "string", "maxLength": 256 },
    "return_terms_ref": { "type": "string", "maxLength": 256 },
    "warranty_terms_ref": { "type": "string", "maxLength": 256 },
    "source_ref": { "type": "string", "maxLength": 2048 },
    "observed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
