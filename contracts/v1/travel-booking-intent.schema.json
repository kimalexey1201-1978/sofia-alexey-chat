{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/travel-booking-intent.schema.json",
  "title": "Sofia Travel Booking Intent",
  "description": "Exact-parameter travel booking request; preparation is not approval or execution.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["booking_intent_id", "trip_id", "provider_id", "service_type", "option_ref", "traveler_refs", "total_amount", "currency", "status", "purpose", "requested_at", "authority_envelope_ref", "policy_decision_ref"],
  "properties": {
    "booking_intent_id": { "type": "string", "format": "uuid" },
    "trip_id": { "type": "string", "format": "uuid" },
    "provider_id": { "type": "string", "maxLength": 160 },
    "service_type": { "type": "string", "enum": ["air", "rail", "bus", "lodging", "rental", "activity", "transfer", "other"] },
    "option_ref": { "type": "string", "maxLength": 256 },
    "traveler_refs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "maxLength": 256 } },
    "service_start_at": { "type": "string", "format": "date-time" },
    "service_end_at": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string", "maxLength": 128 },
    "fare_or_room_class": { "type": "string", "maxLength": 128 },
    "baggage_terms_ref": { "type": "string", "maxLength": 256 },
    "cancellation_terms_ref": { "type": "string", "maxLength": 256 },
    "total_amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$", "maxLength": 40 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "status": { "type": "string", "enum": ["draft", "awaiting_confirmation", "approved", "submitted", "provider_accepted", "confirmed", "ticketed", "waitlisted", "rejected", "cancelled", "refunded", "completion_unknown"] },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
    "authority_envelope_ref": { "type": "string", "maxLength": 256 },
    "policy_decision_ref": { "type": "string", "maxLength": 256 },
    "approval_ref": { "type": "string", "maxLength": 256 },
    "parameter_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "idempotency_key": { "type": "string", "maxLength": 256 },
    "provider_booking_ref": { "type": "string", "maxLength": 256 },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
