{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/sensor-observation.schema.json",
  "title": "Sofia Sensor Observation",
  "description": "Normalized sensor fact or derived feature with explicit provenance; model inference must not be represented as a raw sensor fact.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "device_id",
    "capability_id",
    "capture_session_id",
    "sensor_type",
    "observed_at",
    "ingested_at",
    "observation_kind",
    "data_classification",
    "purpose",
    "provenance"
  ],
  "properties": {
    "observation_id": { "type": "string", "format": "uuid" },
    "device_id": { "type": "string", "maxLength": 128 },
    "capability_id": { "type": "string", "format": "uuid" },
    "capture_session_id": { "type": "string", "format": "uuid" },
    "sensor_type": { "type": "string", "maxLength": 64 },
    "observed_at": { "type": "string", "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "observation_kind": {
      "type": "string",
      "enum": ["raw_measurement", "normalized_measurement", "derived_feature", "model_inference"]
    },
    "value": {
      "type": ["number", "integer", "string", "boolean", "object", "array", "null"],
      "description": "Small normalized value only; large binary payloads must use an opaque reference."
    },
    "unit": { "type": "string", "maxLength": 64 },
    "payload_reference": { "type": "string", "maxLength": 2048 },
    "integrity_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "data_classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 160 },
    "consent_reference": { "type": "string", "maxLength": 256 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_adapter_id", "source_integrity_status"],
      "properties": {
        "source_adapter_id": { "type": "string", "maxLength": 160 },
        "source_adapter_version": { "type": "string", "maxLength": 64 },
        "source_integrity_status": {
          "type": "string",
          "enum": ["verified", "unverified", "degraded", "invalid"]
        },
        "transformation_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 256 }
        },
        "source_observation_id": { "type": "string", "format": "uuid" }
      }
    },
    "retention_expires_at": { "type": "string", "format": "date-time" }
  },
  "oneOf": [
    { "required": ["value"], "not": { "required": ["payload_reference"] } },
    { "required": ["payload_reference"], "not": { "required": ["value"] } }
  ]
}
