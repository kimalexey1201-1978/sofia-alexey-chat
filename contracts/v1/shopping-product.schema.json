{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/shopping-product.schema.json",
  "title": "Sofia Shopping Product",
  "description": "Normalized product identity and source provenance for discovery and comparison.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "name", "source_ref", "observed_at"],
  "properties": {
    "product_id": { "type": "string", "maxLength": 256 },
    "name": { "type": "string", "minLength": 1, "maxLength": 512 },
    "brand": { "type": "string", "maxLength": 256 },
    "model": { "type": "string", "maxLength": 256 },
    "sku": { "type": "string", "maxLength": 128 },
    "gtin": { "type": "string", "maxLength": 32 },
    "variant": { "type": "object", "additionalProperties": false, "properties": {
      "size": { "type": "string", "maxLength": 64 },
      "color": { "type": "string", "maxLength": 64 },
      "condition": { "type": "string", "enum": ["new", "used", "refurbished", "open_box", "unknown"] },
      "region": { "type": "string", "maxLength": 64 }
    }},
    "specification_refs": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 256 } },
    "compatibility_evidence_ref": { "type": "string", "maxLength": 256 },
    "source_ref": { "type": "string", "maxLength": 2048 },
    "observed_at": { "type": "string", "format": "date-time" }
  }
}
