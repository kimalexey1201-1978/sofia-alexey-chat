{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/workflow-checkpoint.schema.json",
  "title": "Sofia Workflow Checkpoint",
  "description": "Integrity-protected recovery boundary; a checkpoint is not authorization to replay actions.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_id",
    "workflow_instance_id",
    "definition_version",
    "workflow_revision",
    "created_at",
    "state_reference",
    "integrity_sha256",
    "data_classification"
  ],
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "format": "uuid"
    },
    "workflow_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "definition_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "workflow_revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "state_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "integrity_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "completed_step_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 256 }
    },
    "pending_step_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 256 }
    },
    "data_classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "retention_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "recovery_status": {
      "type": "string",
      "enum": ["available", "used", "superseded", "invalidated"],
      "default": "available"
    }
  }
}
