{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/device-trust-assessment.schema.json",
  "title": "Sofia AI Device Trust Assessment v1",
  "description": "Time-bounded evidence assessment of a device identity and posture. Device trust is not owner authentication, capability authorization, connection state or health.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "device_ref",
    "verdict",
    "evidence",
    "assessed_at",
    "expires_at",
    "policy_version"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "device_ref": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "verdict": {
      "type": "string",
      "enum": [
        "trusted",
        "trusted_with_limits",
        "untrusted",
        "unknown",
        "revoked"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "status",
          "observed_at"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "cryptographic_identity",
              "secure_pairing",
              "platform_attestation",
              "key_status",
              "owner_confirmation",
              "vendor_account_binding",
              "integrity_signal"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "unavailable",
              "stale",
              "not_supported"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "maxLength": 256
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "details_code": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "allowed_use_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "read_only",
          "personal_output",
          "sensor_input",
          "physical_control",
          "administration"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "revocation_ref": {
      "type": "string",
      "maxLength": 256
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "assessor_ref": {
      "type": "string",
      "maxLength": 180
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 128
    }
  }
}