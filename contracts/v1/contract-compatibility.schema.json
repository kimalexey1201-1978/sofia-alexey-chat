{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/contract-compatibility.schema.json",
  "title": "Sofia AI Contract Compatibility Declaration",
  "description": "Explicit compatibility decision between producer and consumer contract versions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compatibility_id",
    "contract_id",
    "producer_version",
    "consumer_version",
    "compatibility",
    "verified_at",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "compatibility_id": { "type": "string", "minLength": 1, "maxLength": 180 },
    "contract_id": { "type": "string", "minLength": 1, "maxLength": 180 },
    "producer_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "consumer_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "compatibility": { "type": "string", "enum": ["compatible", "compatible_with_adapter", "incompatible", "not_verified"] },
    "adapter_module_id": { "type": "string", "maxLength": 180 },
    "verified_at": { "type": "string", "format": "date-time" },
    "verified_by": { "type": "string", "maxLength": 200 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 1000 }
    },
    "migration_notes": { "type": "string", "maxLength": 4000 }
  },
  "allOf": [
    {
      "if": { "properties": { "compatibility": { "const": "compatible_with_adapter" } }, "required": ["compatibility"] },
      "then": { "required": ["adapter_module_id", "migration_notes"] }
    }
  ]
}