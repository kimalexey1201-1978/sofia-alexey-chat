{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/knowledge-search-request.schema.json",
  "title": "Sofia Knowledge Search Request",
  "description": "Bounded search request with explicit freshness, source scope, locale, and resource limits.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "requester_principal_id", "query", "search_scope", "requested_at"],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "requester_principal_id": { "type": "string", "maxLength": 128 },
    "query": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "search_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 160 }
    },
    "source_ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 160 }
    },
    "language_tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 35 }
    },
    "locale_or_jurisdiction": { "type": "string", "maxLength": 128 },
    "freshness_max_age_seconds": { "type": "integer", "minimum": 0, "maximum": 315360000 },
    "max_results": { "type": "integer", "minimum": 1, "maximum": 200, "default": 20 },
    "max_bytes": { "type": "integer", "minimum": 1024, "maximum": 104857600 },
    "deadline_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "max_cost_units": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "data_classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "require_primary_sources": { "type": "boolean", "default": false },
    "include_full_text": { "type": "boolean", "default": false },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
