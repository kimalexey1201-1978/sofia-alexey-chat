{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/module-integration-binding.schema.json",
  "title": "Sofia AI Module Integration Binding",
  "description": "Version-pinned binding between a module, a capability contract and the policy/runtime controls required to invoke it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "module_id",
    "module_version",
    "capability_id",
    "contract_id",
    "contract_version",
    "input_schema_ref",
    "output_schema_ref",
    "required_controls",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "binding_id": { "type": "string", "minLength": 1, "maxLength": 180 },
    "module_id": { "type": "string", "minLength": 1, "maxLength": 180 },
    "module_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "capability_id": { "type": "string", "minLength": 1, "maxLength": 180 },
    "contract_id": { "type": "string", "minLength": 1, "maxLength": 180 },
    "contract_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "input_schema_ref": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "output_schema_ref": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "required_controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["authentication", "authorization", "consent", "data_classification", "resource_budget", "audit", "independent_verification", "idempotency", "user_approval", "device_permission"]
      }
    },
    "data_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] }
    },
    "risk_tier": { "type": "string", "enum": ["R0", "R1", "R2", "R3"] },
    "idempotency": { "type": "string", "enum": ["idempotent", "deduplicated", "non_idempotent", "read_only"] },
    "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "max_payload_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 1000 }
    },
    "status": { "type": "string", "enum": ["draft", "validating", "approved", "active", "suspended", "revoked"] },
    "approved_at": { "type": "string", "format": "date-time" },
    "policy_version": { "type": "string", "maxLength": 80 }
  }
}