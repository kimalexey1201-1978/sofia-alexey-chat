{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/resource-budget.schema.json",
  "title": "Sofia AI Resource Budget v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "budget_id",
    "subject_ref",
    "workload_class",
    "priority",
    "limits",
    "issued_at",
    "expires_at",
    "policy_version"
  ],
  "properties": {
    "budget_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workload_class": {
      "enum": [
        "safety_control",
        "active_interaction",
        "required_task",
        "maintenance",
        "optional_background"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_time_ms": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_memory_mb": {
          "type": "integer",
          "minimum": 0
        },
        "npu_memory_mb": {
          "type": "integer",
          "minimum": 0
        },
        "storage_mb": {
          "type": "integer",
          "minimum": 0
        },
        "network_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "charging_only",
          "unmetered_network_only",
          "foreground_only",
          "wifi_preferred",
          "offline_only",
          "thermal_normal_only"
        ]
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
