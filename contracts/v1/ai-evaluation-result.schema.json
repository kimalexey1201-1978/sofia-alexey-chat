{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/ai-evaluation-result.schema.json",
  "title": "Sofia AI Evaluation Result v1",
  "description": "Evidence report for one candidate evaluated against one versioned suite. It does not grant permissions or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "schema_version",
    "suite_ref",
    "candidate_ref",
    "candidate_version",
    "status",
    "started_at",
    "completed_at",
    "sample_count",
    "slice_results",
    "hard_gates_passed",
    "uncertainty_summary",
    "evaluator_version",
    "report_ref"
  ],
  "properties": {
    "evaluation_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0"
    },
    "suite_ref": {
      "type": "string",
      "maxLength": 512
    },
    "candidate_ref": {
      "type": "string",
      "maxLength": 256
    },
    "candidate_version": {
      "type": "string",
      "maxLength": 100
    },
    "status": {
      "enum": [
        "qualified",
        "rejected",
        "insufficient_evidence",
        "failed",
        "cancelled"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "slice_results": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slice_id",
          "sample_count",
          "metrics"
        ],
        "properties": {
          "slice_id": {
            "type": "string",
            "maxLength": 160
          },
          "sample_count": {
            "type": "integer",
            "minimum": 0
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric",
                "value"
              ],
              "properties": {
                "metric": {
                  "type": "string",
                  "maxLength": 100
                },
                "value": {
                  "type": "number"
                },
                "lower_bound": {
                  "type": "number"
                },
                "upper_bound": {
                  "type": "number"
                },
                "threshold_passed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "hard_gates_passed": {
      "type": "boolean"
    },
    "uncertainty_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "evaluator_version": {
      "type": "string",
      "maxLength": 64
    },
    "report_ref": {
      "type": "string",
      "maxLength": 512
    },
    "regression_baseline_ref": {
      "type": "string",
      "maxLength": 512
    },
    "critical_findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "approved_task_classes": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "qualified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "hard_gates_passed": {
            "const": true
          },
          "sample_count": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "insufficient_evidence"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_task_classes": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
