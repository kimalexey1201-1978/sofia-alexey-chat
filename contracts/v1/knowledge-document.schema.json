{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/knowledge-document.schema.json",
  "title": "Sofia Knowledge Document",
  "description": "Normalized document metadata and version identity while preserving original source locators.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "source_id", "title", "content_hash_sha256", "retrieved_at", "data_classification"],
  "properties": {
    "document_id": { "type": "string", "format": "uuid" },
    "source_id": { "type": "string", "maxLength": 160 },
    "canonical_uri": { "type": "string", "maxLength": 2048 },
    "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "publisher": { "type": "string", "maxLength": 256 },
    "author_names": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "maxLength": 256 }
    },
    "published_at": { "type": "string", "format": "date-time" },
    "updated_at_source": { "type": "string", "format": "date-time" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "content_hash_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "mime_type": { "type": "string", "maxLength": 128 },
    "language_tag": { "type": "string", "maxLength": 35 },
    "version_label": { "type": "string", "maxLength": 128 },
    "index_status": {
      "type": "string",
      "enum": ["not_indexed", "queued", "indexed", "partial", "failed", "deleted", "access_revoked"]
    },
    "data_classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "retention_expires_at": { "type": "string", "format": "date-time" }
  }
}
