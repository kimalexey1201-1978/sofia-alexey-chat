{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/device-credential-record.schema.json",
  "title": "Sofia AI Device Credential Record v1",
  "description": "Metadata and opaque secure-store references for device credentials. Private key material and shared secrets must never be stored in this record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["credential_ref", "device_ref", "credential_type", "algorithm", "status", "created_at", "updated_at"],
  "properties": {
    "credential_ref": {"type": "string", "minLength": 8, "maxLength": 256},
    "device_ref": {"type": "string", "minLength": 8, "maxLength": 256},
    "credential_type": {"type": "string", "enum": ["device_public_key", "platform_key_handle", "vendor_credential_handle", "attestation_certificate_ref"]},
    "algorithm": {"type": "string", "minLength": 1, "maxLength": 80},
    "public_key_fingerprint": {"type": "string", "maxLength": 256},
    "public_key_ref": {"type": "string", "maxLength": 256},
    "secure_store_handle_ref": {"type": "string", "maxLength": 256},
    "attestation_ref": {"type": "string", "maxLength": 256},
    "hardware_backing": {"type": "string", "enum": ["hardware_verified", "platform_protected", "software_only", "unknown", "not_applicable"]},
    "status": {"type": "string", "enum": ["pending", "active", "rotation_pending", "suspended", "revoked", "expired", "compromised"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "supersedes_credential_ref": {"type": "string", "maxLength": 256},
    "revocation_ref": {"type": "string", "maxLength": 256},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "maxLength": 128}
  }
}