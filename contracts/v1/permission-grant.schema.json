{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/permission-grant.schema.json",
  "title": "Sofia AI Permission Grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "subject",
    "capability",
    "operations",
    "resource_scope",
    "purpose",
    "issued_at",
    "expires_at",
    "status",
    "policy_version"
  ],
  "properties": {
    "grant_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_type",
        "principal_id"
      ],
      "properties": {
        "principal_type": {
          "enum": [
            "owner",
            "device",
            "module",
            "service"
          ]
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "module_version": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "resource_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_type"
      ],
      "properties": {
        "scope_type": {
          "enum": [
            "exact",
            "allow_list",
            "namespace",
            "self",
            "none"
          ]
        },
        "resource_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "namespace": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "constraints": {
      "type": "object",
      "description": "Policy-defined constraints; consumers must reject unknown constraint keys unless explicitly supported.",
      "additionalProperties": true
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_by": {
      "type": "string",
      "maxLength": 256
    },
    "approval_reference": {
      "type": "string",
      "maxLength": 256
    },
    "status": {
      "enum": [
        "active",
        "revoked",
        "expired",
        "suspended"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "revocation_reason": {
      "type": "string",
      "maxLength": 512
    }
  }
}
