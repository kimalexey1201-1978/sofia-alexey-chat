{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.example/contracts/v1/memory-write-decision.schema.json",
  "title": "Sofia AI Memory Write Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "candidate_ref",
    "decided_at",
    "decision",
    "reason_codes",
    "policy_version"
  ],
  "properties": {
    "decision_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "candidate_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "decided_at": { "type": "string", "format": "date-time" },
    "decision": {
      "enum": ["REJECT", "TRANSIENT_ONLY", "KEEP_CANDIDATE", "REQUIRE_OWNER_CONFIRMATION", "PERSIST"]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 96 }
    },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "owner_approval_ref": { "type": "string", "maxLength": 256 },
    "retention_policy_ref": { "type": "string", "maxLength": 256 },
    "allowed_scopes": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 256 }
    },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
