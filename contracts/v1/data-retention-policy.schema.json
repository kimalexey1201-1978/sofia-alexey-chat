{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/data-retention-policy.schema.json",
  "title": "Sofia AI Data Retention Policy",
  "description": "Versioned lifecycle rule for a data category and purpose.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "data_categories", "purpose_ids", "retention_mode", "max_retention_seconds", "deletion_behavior", "version", "enabled"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "policy_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "data_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "purpose_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "retention_mode": { "type": "string", "enum": ["duration", "until_event", "user_controlled", "legal_hold"] },
    "max_retention_seconds": { "type": "integer", "minimum": 0 },
    "deletion_behavior": { "type": "string", "enum": ["hard_delete", "cryptographic_erasure", "irreversible_deidentification", "expire_from_backup", "manual_review_required"] },
    "backup_expiry_seconds": { "type": "integer", "minimum": 0 },
    "processor_propagation_required": { "type": "boolean" },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "enabled": { "type": "boolean" },
    "approved_by": { "type": "string", "maxLength": 200 },
    "approved_at": { "type": "string", "format": "date-time" }
  }
}