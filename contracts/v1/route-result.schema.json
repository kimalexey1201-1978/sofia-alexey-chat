{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/route-result.schema.json",
  "title": "Sofia Route Result",
  "description": "Provider-sourced route alternatives with estimates, freshness, and caveats.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_request_id", "provider_id", "calculated_at", "status", "alternatives"],
  "properties": {
    "route_request_id": { "type": "string", "format": "uuid" },
    "provider_id": { "type": "string", "maxLength": 160 },
    "provider_api_version": { "type": "string", "maxLength": 64 },
    "calculated_at": { "type": "string", "format": "date-time" },
    "traffic_updated_at": { "type": "string", "format": "date-time" },
    "transit_updated_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["success", "partial", "no_route", "provider_unavailable", "invalid_request"] },
    "alternatives": { "type": "array", "maxItems": 10, "items": { "type": "object", "additionalProperties": false, "required": ["route_id", "travel_mode", "estimated_duration_seconds"], "properties": {
      "route_id": { "type": "string", "maxLength": 256 },
      "travel_mode": { "type": "string", "enum": ["walking", "cycling", "driving", "transit", "multimodal"] },
      "distance_meters": { "type": "number", "minimum": 0 },
      "estimated_duration_seconds": { "type": "integer", "minimum": 0 },
      "estimated_arrival_at": { "type": "string", "format": "date-time" },
      "toll_estimate": { "type": "number", "minimum": 0 },
      "warnings": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 512 } }
    }}},
    "source_uri": { "type": "string", "maxLength": 2048 },
    "caveats": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 512 } }
  }
}
