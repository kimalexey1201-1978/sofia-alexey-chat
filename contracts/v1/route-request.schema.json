{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/route-request.schema.json",
  "title": "Sofia Route Request",
  "description": "Typed route planning request with explicit travel mode and constraints.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_request_id", "destination", "travel_modes", "requested_at"],
  "properties": {
    "route_request_id": { "type": "string", "format": "uuid" },
    "origin": { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {
      "kind": { "type": "string", "enum": ["current_location", "coordinate", "address", "place_id"] },
      "value": { "type": "string", "minLength": 1, "maxLength": 2048 }
    }},
    "destination": { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {
      "kind": { "type": "string", "enum": ["coordinate", "address", "place_id"] },
      "value": { "type": "string", "minLength": 1, "maxLength": 2048 }
    }},
    "travel_modes": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "enum": ["walking", "cycling", "driving", "transit", "multimodal"] } },
    "departure_at": { "type": "string", "format": "date-time" },
    "arrival_by": { "type": "string", "format": "date-time" },
    "avoidances": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "enum": ["tolls", "highways", "ferries", "stairs", "unpaved", "restricted_zones"] } },
    "accessibility_requirements": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "maxLength": 128 } },
    "vehicle_constraints_ref": { "type": "string", "maxLength": 256 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
