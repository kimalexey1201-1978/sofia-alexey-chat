{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/ai-evaluation-suite.schema.json",
  "title": "Sofia AI Evaluation Suite v1",
  "description": "Versioned definition of a task-specific AI evaluation suite.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_id",
    "schema_version",
    "suite_version",
    "capability",
    "task_classes",
    "dataset",
    "metrics",
    "thresholds",
    "evaluator",
    "status",
    "created_at"
  ],
  "properties": {
    "suite_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "schema_version": {
      "const": "1.0"
    },
    "suite_version": {
      "type": "string",
      "pattern": "^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$"
    },
    "capability": {
      "enum": [
        "text_generation",
        "structured_output",
        "translation",
        "speech_recognition",
        "speech_synthesis",
        "vision",
        "ocr",
        "tool_proposal",
        "planning",
        "reasoning",
        "embedding"
      ]
    },
    "task_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_ref",
        "version",
        "provenance_ref",
        "license",
        "permitted_use",
        "integrity_hash"
      ],
      "properties": {
        "dataset_ref": {
          "type": "string",
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "provenance_ref": {
          "type": "string",
          "maxLength": 512
        },
        "license": {
          "type": "string",
          "maxLength": 160
        },
        "permitted_use": {
          "enum": [
            "internal_evaluation",
            "licensed_evaluation",
            "public_benchmark",
            "synthetic_test_only"
          ]
        },
        "integrity_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "holdout": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "accuracy",
          "adequacy",
          "semantic_preservation",
          "completeness",
          "schema_conformance",
          "safety_violation_rate",
          "privacy_leakage_rate",
          "availability",
          "timeout_rate",
          "latency_p95_ms",
          "cost_per_success",
          "robustness",
          "calibration_error",
          "human_review_score"
        ]
      }
    },
    "thresholds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "operator",
          "value",
          "hard_gate"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "maxLength": 100
          },
          "operator": {
            "enum": [
              "gte",
              "lte",
              "eq"
            ]
          },
          "value": {
            "type": "number"
          },
          "hard_gate": {
            "type": "boolean"
          }
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_id",
        "version"
      ],
      "properties": {
        "evaluator_id": {
          "type": "string",
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "human_review_required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "coverage_slices": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "known_limitations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "deprecated",
        "retired"
      ]
    },
    "approval_ref": {
      "type": "string",
      "maxLength": 256
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
