{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.example/contracts/v1/orchestration-decision.schema.json",
  "title": "Sofia AI Orchestration Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "task_id",
    "plan_id",
    "plan_version",
    "decided_at",
    "decision",
    "reason_codes",
    "policy_version"
  ],
  "properties": {
    "decision_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "plan_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "plan_version": { "type": "integer", "minimum": 1 },
    "step_id": { "type": "string", "maxLength": 128 },
    "decided_at": { "type": "string", "format": "date-time" },
    "decision": { "enum": ["ACCEPT_PLAN", "REJECT_PLAN", "REQUEST_OWNER_INPUT", "DISPATCH_STEP", "BLOCK_STEP", "PAUSE_TASK", "CANCEL_TASK", "REPLAN", "MARK_PARTIAL", "COMPLETE_TASK"] },
    "reason_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "maxLength": 96 } },
    "security_decision_ref": { "type": "string", "maxLength": 256 },
    "resource_reservation_ref": { "type": "string", "maxLength": 256 },
    "owner_approval_ref": { "type": "string", "maxLength": 256 },
    "execution_request_ref": { "type": "string", "maxLength": 256 },
    "next_plan_version": { "type": "integer", "minimum": 1 },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 80 }
  }
}
