{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/device-enrollment-transaction.schema.json",
  "title": "Sofia AI Device Enrollment Transaction v1",
  "description": "Orchestration record for owner-visible enrollment. It references IAM, DTM, SDM and CPR decisions but does not itself authenticate, establish trust or grant capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["transaction_id", "owner_principal_ref", "owner_session_ref", "candidate_device_ref", "request_digest", "state", "created_at", "expires_at", "policy_version", "idempotency_key"],
  "properties": {
    "transaction_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "owner_principal_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "owner_session_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "owner_auth_context_ref": {"type": "string", "maxLength": 256},
    "candidate_device_ref": {"type": "string", "minLength": 8, "maxLength": 256},
    "request_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "requested_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "contract_version", "operations", "risk_tier"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1, "maxLength": 180},
          "contract_version": {"type": "string", "minLength": 1, "maxLength": 80},
          "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
          "target_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 256}},
          "data_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["public", "user_content", "personal_data", "sensitive_data", "credentials", "device_telemetry"]}},
          "risk_tier": {"type": "string", "enum": ["R0", "R1", "R2", "R3", "unknown"]},
          "sensor_access": {"type": "boolean"},
          "physical_side_effect": {"type": "boolean"},
          "external_data_egress": {"type": "boolean"},
          "requested_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
          "declaration_ref": {"type": "string", "maxLength": 256}
        }
      }
    },
    "approved_capability_request_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 256}},
    "consent_ref": {"type": "string", "maxLength": 256},
    "pairing_challenge_ref": {"type": "string", "maxLength": 256},
    "credential_ref": {"type": "string", "maxLength": 256},
    "trust_assessment_ref": {"type": "string", "maxLength": 256},
    "registry_device_ref": {"type": "string", "maxLength": 256},
    "capability_grant_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 256}},
    "state": {"type": "string", "enum": ["created", "candidate_selected", "owner_auth_required", "disclosure_pending", "awaiting_owner_consent", "consent_rejected", "pairing_pending", "proof_submitted", "trust_pending", "trust_limited", "registry_pending", "permission_review_pending", "partially_enrolled", "completed", "blocked", "expired", "cancelled", "revocation_pending", "revoked"]},
    "reason_code": {"type": "string", "maxLength": 128},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "contract_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 80}},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 256},
    "correlation_id": {"type": "string", "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}