{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/device-runtime-profile.schema.json",
  "title": "Sofia AI Device Runtime Profile v1",
  "description": "Declared resource and isolation requirements for an adapter runtime. A profile is a request and does not itself authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "adapter_id", "adapter_version", "artifact_digest", "platform", "runtime_kind", "isolation_level", "resource_limits", "created_at"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "adapter_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "adapter_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "artifact_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "platform": {"type": "string", "enum": ["android", "ios", "windows", "linux", "macos", "embedded", "cloud"]},
    "minimum_platform_version": {"type": "string", "maxLength": 80},
    "runtime_kind": {"type": "string", "enum": ["platform_api_wrapper", "isolated_process", "wasm", "container", "remote_service"]},
    "isolation_level": {"type": "string", "enum": ["host_managed_api", "separate_process", "sandboxed_runtime", "remote_boundary", "none", "unknown"]},
    "required_permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 180}},
    "background_mode": {"type": "string", "enum": ["foreground_only", "foreground_service", "deferrable_scheduled", "no_background", "not_applicable"]},
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_memory_mb", "max_execution_ms", "max_concurrency"],
      "properties": {
        "max_memory_mb": {"type": "integer", "minimum": 1, "maximum": 65536},
        "max_execution_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_storage_mb": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "max_network_bytes": {"type": "integer", "minimum": 0},
        "max_cpu_ms": {"type": "integer", "minimum": 1},
        "min_battery_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "thermal_policy": {"type": "string", "enum": ["allow", "reduce_optional_work", "pause", "stop"]}
      }
    },
    "network_egress_allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 253}},
    "credential_handle_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 256}},
    "supports_cancellation": {"type": "boolean"},
    "supports_reconciliation": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}