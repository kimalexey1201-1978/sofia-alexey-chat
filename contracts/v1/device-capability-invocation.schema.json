{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/device-capability-invocation.schema.json",
  "title": "Sofia AI Device Capability Invocation v1",
  "description": "Task-bound invocation passed by the trusted execution path to the Device Capability Broker. It is a request envelope, not permission by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["invocation_id", "task_id", "correlation_id", "idempotency_key", "principal_ref", "session_ref", "device_ref", "adapter_id", "adapter_version", "artifact_digest", "capability_id", "capability_contract_version", "operation", "target_ref", "input_digest", "risk_tier", "deadline_at", "grant_ref", "security_decision_ref", "resource_reservation_ref"],
  "properties": {
    "invocation_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlation_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 256},
    "principal_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "session_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "device_ref": {"type": "string", "minLength": 8, "maxLength": 256},
    "adapter_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "adapter_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "artifact_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "capability_id": {"type": "string", "minLength": 1, "maxLength": 180},
    "capability_contract_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "input_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "input_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "data_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["public", "user_content", "personal_data", "sensitive_data", "credentials", "device_telemetry"]}},
    "risk_tier": {"type": "string", "enum": ["R0", "R1", "R2", "R3", "unknown"]},
    "grant_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "authority_envelope_ref": {"type": "string", "maxLength": 256},
    "security_decision_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "approval_ref": {"type": "string", "maxLength": 256},
    "device_trust_assessment_ref": {"type": "string", "maxLength": 256},
    "data_governance_decision_ref": {"type": "string", "maxLength": 256},
    "resource_reservation_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "issued_at": {"type": "string", "format": "date-time"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "cancel_requested": {"type": "boolean"}
  }
}