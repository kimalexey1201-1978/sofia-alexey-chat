{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/file-operation-request.schema.json",
  "title": "Sofia File Operation Request",
  "description": "Authorized, bounded request to import, inspect, transform, export, or delete a managed file.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "requester_principal_id", "operation", "purpose", "requested_at"],
  "properties": {
    "operation_id": { "type": "string", "format": "uuid" },
    "requester_principal_id": { "type": "string", "maxLength": 128 },
    "operation": { "type": "string", "enum": ["import", "inspect", "extract", "transform", "preview", "export", "share", "delete"] },
    "file_id": { "type": "string", "format": "uuid" },
    "source_reference": { "type": "string", "maxLength": 2048 },
    "destination_reference": { "type": "string", "maxLength": 2048 },
    "target_media_type": { "type": "string", "maxLength": 256 },
    "adapter_id": { "type": "string", "maxLength": 160 },
    "adapter_version": { "type": "string", "maxLength": 64 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
    "data_classification": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
    "max_input_bytes": { "type": "integer", "minimum": 1, "maximum": 107374182400 },
    "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 107374182400 },
    "deadline_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "require_user_confirmation": { "type": "boolean", "default": false },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
