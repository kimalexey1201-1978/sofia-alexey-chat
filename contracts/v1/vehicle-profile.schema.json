{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sofia.ai/contracts/v1/vehicle-profile.schema.json",
  "title":"Vehicle Profile",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","vehicle_id","owner_principal_ref","display_name","vehicle_class","capabilities","data_classification","created_at","updated_at"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "vehicle_id":{"type":"string","minLength":1,"maxLength":200},
    "owner_principal_ref":{"type":"string","minLength":1,"maxLength":200},
    "display_name":{"type":"string","minLength":1,"maxLength":100},
    "vehicle_class":{"enum":["passenger_car","bus","truck","motorcycle","van","other"]},
    "manufacturer":{"type":"string","maxLength":100},
    "model":{"type":"string","maxLength":100},
    "model_year":{"type":"integer","minimum":1886,"maximum":2200},
    "market_region":{"type":"string","maxLength":40},
    "vin_secret_ref":{"type":"string","maxLength":200},
    "registration_document_ref":{"type":"string","maxLength":200},
    "provider_connection_ref":{"type":"string","maxLength":200},
    "capabilities":{"type":"array","maxItems":100,"items":{"type":"string","minLength":1,"maxLength":160},"uniqueItems":true},
    "data_classification":{"enum":["confidential","restricted"]},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"}
  }
}
