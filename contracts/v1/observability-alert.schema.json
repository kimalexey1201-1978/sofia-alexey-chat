{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/observability-alert.schema.json",
  "title": "Sofia AI Observability Alert v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert_id",
    "created_at",
    "severity",
    "category",
    "status",
    "source_component",
    "correlation_ids",
    "reason_code",
    "policy_version"
  ],
  "properties": {
    "alert_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "created_at": { "type": "string", "format": "date-time" },
    "severity": { "enum": ["info", "warning", "high", "critical"] },
    "category": {
      "enum": [
        "policy_violation",
        "unauthorized_execution",
        "paid_route_attempt",
        "capability_bypass",
        "identity_anomaly",
        "resource_anomaly",
        "data_egress_anomaly",
        "module_integrity",
        "audit_integrity",
        "audit_pipeline_health",
        "operational_reliability"
      ]
    },
    "status": { "enum": ["open", "acknowledged", "investigating", "resolved", "false_positive"] },
    "source_component": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlation_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 8, "maxLength": 128 }
    },
    "actor_ref": { "type": "string", "maxLength": 256 },
    "module_ref": { "type": "string", "maxLength": 256 },
    "provider_ref": { "type": "string", "maxLength": 128 },
    "reason_code": { "type": "string", "minLength": 1, "maxLength": 96 },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "related_event_refs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 128 }
    },
    "recommended_response": {
      "enum": ["observe", "notify_owner", "block_action", "suspend_module", "open_incident", "verify_integrity"]
    },
    "response_applied": { "type": "boolean" },
    "response_ref": { "type": "string", "maxLength": 256 },
    "expires_at": { "type": "string", "format": "date-time" },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "window_seconds": { "type": "integer", "minimum": 0 },
        "risk_tier": { "enum": ["R0", "R1", "R2", "R3"] },
        "expected_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "approved_minor_units": { "type": "integer", "minimum": 0 },
        "observed_minor_units": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
