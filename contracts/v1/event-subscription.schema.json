{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/event-subscription.schema.json",
  "title": "Sofia Event Subscription",
  "description": "Versioned, least-privilege subscription declaration. Runtime authorization remains authoritative.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subscription_id",
    "consumer_module_id",
    "event_types",
    "contract_version_constraints",
    "delivery_mode",
    "enabled",
    "created_at"
  ],
  "properties": {
    "subscription_id": {
      "type": "string",
      "format": "uuid"
    },
    "consumer_module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*){1,7}$",
      "maxLength": 160
    },
    "event_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*){1,7}$",
        "maxLength": 160
      }
    },
    "contract_version_constraints": {
      "type": "object",
      "description": "Explicit per-event-type supported contract versions or registered compatibility ranges.",
      "minProperties": 1,
      "maxProperties": 100,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "delivery_mode": {
      "type": "string",
      "enum": ["at_least_once"]
    },
    "ordering": {
      "type": "string",
      "enum": ["none", "per_aggregate_key"],
      "default": "none"
    },
    "max_in_flight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 1
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 8
    },
    "acknowledgment_deadline_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "max_payload_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "allowed_classifications": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["public", "internal", "confidential", "restricted"]
      },
      "uniqueItems": true
    },
    "authorized_purposes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "enabled": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
