{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/deployment-attestation.schema.json",
  "title": "Sofia AI Deployment Attestation",
  "description": "Provenance and integrity record for a deployment candidate or completed deployment; contains no secret values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_id",
    "repository",
    "source_commit",
    "artifact",
    "environment",
    "configuration_digest",
    "created_at",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "attestation_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "repository": { "type": "string", "minLength": 3, "maxLength": 300 },
    "source_branch": { "type": "string", "maxLength": 200 },
    "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "workflow_run_id": { "type": "string", "maxLength": 160 },
    "build_toolchain_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dependency_lock_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "media_type", "size_bytes", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "media_type": { "type": "string", "maxLength": 160 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "storage_reference": { "type": "string", "maxLength": 1000 }
      }
    },
    "environment": { "type": "string", "enum": ["development", "test", "staging", "production"] },
    "configuration_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "secret_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding_name", "presence_status"],
        "properties": {
          "binding_name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "presence_status": { "type": "string", "enum": ["present", "absent", "not_checked", "not_applicable"] },
          "checked_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "test_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 160 }
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 160 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "deployed_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["candidate", "verified", "authorized", "deployed", "rolled_back", "rejected"] },
    "authorization_reference": { "type": "string", "maxLength": 1000 },
    "rollback_reference": { "type": "string", "maxLength": 1000 }
  }
}