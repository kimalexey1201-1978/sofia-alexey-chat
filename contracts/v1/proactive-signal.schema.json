{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/proactive-signal.schema.json",
  "title": "Sofia Proactive Signal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "principal_ref",
    "purpose",
    "source_type",
    "source_ref",
    "occurred_at",
    "received_at",
    "epistemic_status",
    "data_classification",
    "policy_refs",
    "deduplication_key"
  ],
  "properties": {
    "signal_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "principal_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_type": {
      "enum": [
        "task_milestone",
        "authorized_event",
        "owner_reminder",
        "owner_preference",
        "verified_memory",
        "scheduler_invocation",
        "foreground_interaction"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "epistemic_status": {
      "enum": [
        "observed",
        "owner_stated",
        "externally_reported",
        "derived",
        "inferred",
        "unknown",
        "disputed"
      ]
    },
    "source_trust_status": {
      "enum": [
        "trusted",
        "limited",
        "unknown",
        "untrusted",
        "revoked"
      ]
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "sensitive",
        "restricted"
      ]
    },
    "freshness_status": {
      "enum": [
        "current",
        "aging",
        "stale",
        "unknown"
      ]
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "deduplication_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
