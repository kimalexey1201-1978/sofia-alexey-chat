{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/notification-delivery-record.schema.json",
  "title": "Sofia Notification Delivery Record",
  "description": "Evidence-based channel delivery lifecycle. Sent, delivered, displayed, and read are distinct states.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delivery_id",
    "notification_id",
    "channel",
    "status",
    "attempt",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "delivery_id": { "type": "string", "format": "uuid" },
    "notification_id": { "type": "string", "format": "uuid" },
    "device_id": { "type": "string", "maxLength": 128 },
    "channel": {
      "type": "string",
      "enum": ["in_app", "android", "web_push", "email", "sms", "wearable", "vehicle", "smart_display"]
    },
    "adapter_id": { "type": "string", "maxLength": 160 },
    "status": {
      "type": "string",
      "enum": ["scheduled", "due", "queued", "sending", "sent", "delivered", "displayed", "read", "dismissed", "deferred", "failed", "expired", "cancelled", "unknown"]
    },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 100 },
    "provider_receipt_ref": { "type": "string", "maxLength": 512 },
    "last_error_code": { "type": "string", "maxLength": 128 },
    "next_attempt_at": { "type": "string", "format": "date-time" },
    "sent_at": { "type": "string", "format": "date-time" },
    "delivered_at": { "type": "string", "format": "date-time" },
    "displayed_at": { "type": "string", "format": "date-time" },
    "read_at": { "type": "string", "format": "date-time" },
    "dismissed_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "format": "uuid" }
  }
}
