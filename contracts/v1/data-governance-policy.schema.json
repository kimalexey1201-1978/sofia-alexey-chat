{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/data-governance-policy.schema.json",
  "title": "Sofia AI Data Governance Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "enabled",
    "data_categories",
    "purpose_ids",
    "allowed_operations",
    "classification_ceiling",
    "processor_policy",
    "retention_policy_ref",
    "owner_approval_required_for"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "policy_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "enabled": { "type": "boolean" },
    "data_categories": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "purpose_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "allowed_operations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["collect", "read", "write", "transform", "infer", "summarize", "export", "share", "disclose", "retain", "delete", "train", "fine_tune"] }
    },
    "classification_ceiling": { "enum": ["public", "internal", "confidential", "restricted"] },
    "processor_policy": { "enum": ["approved_allowlist_only", "owner_approval_per_processor", "local_processing_only", "deny_external_processing"] },
    "approved_processor_refs": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "maxLength": 256 }
    },
    "allowed_regions": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "maxLength": 80 }
    },
    "cross_border_transfer": { "enum": ["deny", "approved_regions_only", "owner_approval_required"] },
    "retention_policy_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "owner_approval_required_for": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["new_purpose", "new_processor", "external_disclosure", "cross_border_transfer", "sensor_capture", "training_use", "retention_extension", "declassification", "deletion_exception"] }
    },
    "consent_required": { "type": "boolean" },
    "free_only": { "type": "boolean" },
    "policy_expires_at": { "type": "string", "format": "date-time" },
    "approved_by": { "type": "string", "maxLength": 200 },
    "approved_at": { "type": "string", "format": "date-time" }
  }
}
