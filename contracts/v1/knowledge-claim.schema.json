{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.example/contracts/v1/knowledge-claim.schema.json",
  "title": "Sofia AI Knowledge Claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "schema_version",
    "subject_ref",
    "predicate",
    "claim_type",
    "epistemic_status",
    "scope",
    "created_at",
    "evidence_refs"
  ],
  "properties": {
    "claim_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "schema_version": { "const": "1.0.0" },
    "subject_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "predicate": { "type": "string", "minLength": 1, "maxLength": 160 },
    "object_value": {},
    "qualifiers": { "type": "object", "additionalProperties": true },
    "claim_type": { "enum": ["observed", "owner_stated", "externally_sourced", "verified", "inferred", "assumed", "unknown", "disputed"] },
    "epistemic_status": { "enum": ["unverified", "corroborated", "owner_confirmed", "externally_verified", "disputed"] },
    "scope": { "type": "string", "minLength": 1, "maxLength": 256 },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "observed_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "derived_from_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 128 }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation_type", "target_claim_id"],
        "properties": {
          "relation_type": { "enum": ["supports", "contradicts", "derived_from", "supersedes", "associated_with", "causal_hypothesis", "part_of"] },
          "target_claim_id": { "type": "string", "maxLength": 128 }
        }
      }
    },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "purpose_id": { "type": "string", "maxLength": 160 },
    "status": { "enum": ["candidate", "active", "stale", "disputed", "superseded", "restricted", "deleted"] }
  }
}
