{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/execution-request.schema.json",
  "title": "Sofia AI Execution Request v1",
  "description": "Canonical, task-bound request passed from Sofia Core to the Execution Supervisor. It describes work and requested authority; it is not itself permission to execute.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "task_id", "correlation_id", "principal_ref", "module_id", "module_version", "capability_id", "operation", "target_ref", "input_ref", "risk_tier", "created_at", "deadline_at", "contract_version"],
  "properties": {
    "request_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlation_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "principal_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "session_ref": {"type": "string", "maxLength": 256},
    "device_ref": {"type": "string", "maxLength": 256},
    "module_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "module_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "artifact_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "capability_id": {"type": "string", "minLength": 1, "maxLength": 180},
    "capability_contract_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "input_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "input_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "risk_tier": {"type": "string", "enum": ["R0", "R1", "R2", "R3", "unknown"]},
    "authority_envelope_ref": {"type": "string", "maxLength": 128},
    "capability_grant_ref": {"type": "string", "maxLength": 128},
    "approval_ref": {"type": "string", "maxLength": 128},
    "idempotency_key": {"type": "string", "maxLength": 256},
    "retry_of_request_id": {"type": "string", "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "metadata": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
  }
}