{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/financial-budget.schema.json",
  "title": "Sofia Financial Budget",
  "description": "User-defined budget envelope with currency and period boundaries.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["budget_id", "principal_id", "name", "currency", "period", "limit_amount", "starts_at", "status"],
  "properties": {
    "budget_id": { "type": "string", "format": "uuid" },
    "principal_id": { "type": "string", "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "period": { "type": "string", "enum": ["weekly", "monthly", "quarterly", "annual", "custom"] },
    "limit_amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$", "maxLength": 40 },
    "category_refs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "maxLength": 128 } },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["draft", "active", "paused", "completed", "archived"] }
  }
}
