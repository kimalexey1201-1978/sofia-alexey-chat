{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/device-stream-subscription.schema.json",
  "title": "Sofia Device Stream Subscription",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subscription_id",
    "principal_ref",
    "module_ref",
    "purpose",
    "event_types",
    "device_scope",
    "field_allowlist",
    "destination",
    "limits",
    "delivery_mode",
    "created_at",
    "expires_at",
    "status"
  ],
  "properties": {
    "subscription_id": {
      "type": "string",
      "format": "uuid"
    },
    "principal_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "module_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "task_ref": {
      "type": "string",
      "maxLength": 256
    },
    "event_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*){1,7}$",
        "maxLength": 160
      }
    },
    "device_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "references"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "explicit_devices",
            "explicit_group"
          ]
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "sensor_scope": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "field_allowlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]{0,127}$"
      }
    },
    "classification_ceiling": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "consent_ref": {
      "type": "string",
      "maxLength": 256
    },
    "capability_grant_ref": {
      "type": "string",
      "maxLength": 256
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_events_per_second",
        "max_burst",
        "max_queue_items",
        "max_queue_bytes",
        "max_payload_bytes",
        "max_concurrent_deliveries"
      ],
      "properties": {
        "max_events_per_second": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "max_burst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_queue_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_queue_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "max_concurrent_deliveries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "delivery_mode": {
      "type": "string",
      "enum": [
        "at_least_once",
        "best_effort_ephemeral"
      ]
    },
    "ordering_scope": {
      "type": "string",
      "enum": [
        "none",
        "per_device_sensor_partition"
      ]
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2592000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "paused",
        "throttled",
        "revoked",
        "expired",
        "failed"
      ]
    }
  }
}
