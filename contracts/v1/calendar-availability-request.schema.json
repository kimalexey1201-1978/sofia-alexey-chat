{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/calendar-availability-request.schema.json",
  "title": "Sofia Calendar Availability Request",
  "description": "Scoped availability query with timezone and scheduling constraints.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "principal_id", "calendar_refs", "window_start", "window_end", "timezone", "requested_at"],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "principal_id": { "type": "string", "maxLength": 128 },
    "calendar_refs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "maxLength": 256 } },
    "window_start": { "type": "string", "format": "date-time" },
    "window_end": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 128 },
    "working_hours_ref": { "type": "string", "maxLength": 256 },
    "buffer_before_minutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
    "buffer_after_minutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
    "travel_time_minutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
