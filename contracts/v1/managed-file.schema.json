{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/managed-file.schema.json",
  "title": "Sofia Managed File",
  "description": "Canonical metadata for a file object or governed external file reference.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["file_id", "original_filename", "declared_media_type", "size_bytes", "content_hash_sha256", "owner_principal_id", "data_classification", "lifecycle_state", "created_at"],
  "properties": {
    "file_id": { "type": "string", "format": "uuid" },
    "original_filename": { "type": "string", "minLength": 1, "maxLength": 512 },
    "declared_media_type": { "type": "string", "maxLength": 256 },
    "detected_media_type": { "type": "string", "maxLength": 256 },
    "format_validation": { "type": "string", "enum": ["pending", "valid", "mismatch", "unsupported", "invalid"] },
    "size_bytes": { "type": "integer", "minimum": 0, "maximum": 107374182400 },
    "content_hash_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "owner_principal_id": { "type": "string", "maxLength": 128 },
    "source_type": { "type": "string", "enum": ["device_upload", "connected_provider", "internal_generated", "url_import", "sensor_capture"] },
    "source_reference": { "type": "string", "maxLength": 2048 },
    "storage_reference": { "type": "string", "maxLength": 2048 },
    "access_control_ref": { "type": "string", "maxLength": 256 },
    "purpose": { "type": "string", "maxLength": 256 },
    "consent_ref": { "type": "string", "maxLength": 256 },
    "data_classification": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
    "lifecycle_state": { "type": "string", "enum": ["quarantined", "validating", "available", "processing", "partially_available", "blocked", "deletion_pending", "deleted"] },
    "version_number": { "type": "integer", "minimum": 1 },
    "parent_file_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "modified_at_source": { "type": "string", "format": "date-time" },
    "imported_at": { "type": "string", "format": "date-time" },
    "last_accessed_at": { "type": "string", "format": "date-time" },
    "retention_expires_at": { "type": "string", "format": "date-time" }
  }
}
