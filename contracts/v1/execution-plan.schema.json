{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/execution-plan.schema.json",
  "title": "Sofia AI Execution Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "request_ref",
    "plan_version",
    "plan_digest",
    "created_at",
    "status",
    "steps",
    "correlation_id"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "request_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "plan_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "awaiting_approval",
        "ready",
        "running",
        "paused",
        "completed",
        "partially_completed",
        "failed",
        "cancelled",
        "outcome_uncertain"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "capability",
          "dependencies",
          "risk_tier",
          "timeout_ms",
          "idempotency_mode"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "module_constraints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 256
            }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          },
          "input_contract": {
            "type": "string",
            "maxLength": 512
          },
          "output_contract": {
            "type": "string",
            "maxLength": 512
          },
          "resource_budget_ref": {
            "type": "string",
            "maxLength": 128
          },
          "risk_tier": {
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3"
            ]
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400000
          },
          "idempotency_mode": {
            "enum": [
              "required",
              "naturally_idempotent",
              "not_applicable"
            ]
          },
          "approval_required": {
            "type": "boolean"
          },
          "verification_method": {
            "type": "string",
            "maxLength": 512
          },
          "compensation_ref": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    }
  }
}
