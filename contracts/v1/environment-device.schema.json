{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/environment-device.schema.json",
  "title": "Smart Environment Device",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "provider_id", "display_name", "device_class", "capabilities", "availability", "data_classification", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "device_class": {"enum": ["light", "switch", "thermostat", "hvac", "shade", "sensor", "plug", "appliance", "lock", "gate", "garage_door", "alarm", "camera", "other"]},
    "manufacturer": {"type": "string", "maxLength": 120},
    "model": {"type": "string", "maxLength": 120},
    "firmware_version": {"type": "string", "maxLength": 80},
    "site_ref": {"type": "string", "maxLength": 200},
    "room_ref": {"type": "string", "maxLength": 200},
    "capabilities": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["capability_id", "operation", "risk_class", "contract_version"], "properties": {"capability_id": {"type": "string", "minLength": 1, "maxLength": 160}, "operation": {"type": "string", "minLength": 1, "maxLength": 120}, "risk_class": {"enum": ["R0", "R1", "R2", "R3"]}, "contract_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}, "parameter_schema_ref": {"type": "string", "maxLength": 500}}}},
    "availability": {"enum": ["available", "unavailable", "degraded", "unknown"]},
    "connection_ref": {"type": "string", "maxLength": 200},
    "ownership_status": {"enum": ["user_confirmed", "account_linked", "unverified", "unknown"]},
    "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
