{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/geofence-definition.schema.json",
  "title": "Sofia Geofence Definition",
  "description": "User-visible, bounded, purpose-specific geographic trigger definition.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["geofence_id", "principal_id", "purpose", "shape", "trigger_on", "created_at", "expires_at", "enabled"],
  "properties": {
    "geofence_id": { "type": "string", "format": "uuid" },
    "principal_id": { "type": "string", "maxLength": 128 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
    "shape": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": {
      "kind": { "type": "string", "enum": ["circle", "polygon"] },
      "center_latitude": { "type": "number", "minimum": -90, "maximum": 90 },
      "center_longitude": { "type": "number", "minimum": -180, "maximum": 180 },
      "radius_meters": { "type": "number", "minimum": 25, "maximum": 50000 },
      "polygon_coordinates_ref": { "type": "string", "maxLength": 256 }
    }},
    "trigger_on": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["enter", "exit", "dwell"] } },
    "active_from": { "type": "string", "format": "date-time" },
    "active_until": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "consent_ref": { "type": "string", "maxLength": 256 },
    "workflow_ref": { "type": "string", "maxLength": 256 },
    "enabled": { "type": "boolean" }
  }
}
