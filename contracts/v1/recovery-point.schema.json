{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.example/contracts/v1/recovery-point.schema.json",
  "title": "Sofia AI Recovery Point v1",
  "description": "Metadata and verification evidence for a scoped backup/recovery point; secret material is excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recovery_point_id",
    "created_at",
    "source_release",
    "scope",
    "integrity",
    "encryption",
    "retention_class",
    "verification_status"
  ],
  "properties": {
    "recovery_point_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_release": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["configuration", "policy", "module_artifacts", "core_artifacts", "application_metadata", "user_content", "conversation_history", "audit_records"]
      }
    },
    "storage_reference": {
      "type": "string",
      "maxLength": 1024
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "verified"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["sha256", "sha384", "sha512"]
        },
        "digest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64,128}$"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_rest", "in_transit", "key_reference"],
      "properties": {
        "at_rest": {"type": "boolean"},
        "in_transit": {"type": "boolean"},
        "key_reference": {
          "type": ["string", "null"],
          "maxLength": 256
        }
      }
    },
    "retention_class": {
      "type": "string",
      "enum": ["temporary", "operational", "user_requested", "compliance"]
    },
    "verification_status": {
      "type": "string",
      "enum": ["verified", "failed", "pending", "restore_tested"]
    },
    "restore_test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tested_at": {"type": "string", "format": "date-time"},
        "result": {
          "type": "string",
          "enum": ["passed", "failed", "not_run"]
        },
        "test_environment": {"type": "string", "maxLength": 256},
        "evidence_ref": {"type": "string", "maxLength": 512}
      }
    },
    "rpo_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "rto_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_approval_id": {
      "type": "string",
      "maxLength": 128
    },
    "audit_event_ids": {
      "type": "array",
      "items": {"type": "string", "maxLength": 128},
      "uniqueItems": true,
      "maxItems": 2048
    }
  }
}
