{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.example/contracts/v1/communication-message.schema.json",
  "title": "Sofia AI Communication Message v1",
  "description": "Normalized message record for supported communication channels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "conversation_id", "channel_id", "sender", "content", "created_at", "delivery_state", "correlation_id"],
  "properties": {
    "message_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "channel_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_message_id": {"type": "string", "maxLength": 256},
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "identity_status"],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "display_name": {"type": "string", "maxLength": 256},
        "identity_status": {"type": "string", "enum": ["authenticated", "provider_asserted", "unverified", "unknown"]}
      }
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipient_ref"],
        "properties": {
          "recipient_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "display_name": {"type": "string", "maxLength": 256}
        }
      },
      "maxItems": 1000
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_type", "body"],
      "properties": {
        "content_type": {"type": "string", "enum": ["text", "audio_reference", "image_reference", "video_reference", "file_reference", "structured"]},
        "body": {"type": "string", "maxLength": 100000},
        "attachment_refs": {"type": "array", "items": {"type": "string", "maxLength": 512}, "maxItems": 100},
        "original_language": {"type": "string", "maxLength": 64},
        "detected_language": {"type": "string", "maxLength": 64},
        "language_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "translation_status": {"type": "string", "enum": ["not_requested", "pending", "completed", "uncertain", "failed"]},
        "translated_content_ref": {"type": "string", "maxLength": 512}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "delivery_state": {"type": "string", "enum": ["draft", "awaiting_approval", "queued", "submitted", "accepted", "delivered", "read", "failed", "cancelled", "unknown"]},
    "approval_id": {"type": "string", "maxLength": 128},
    "idempotency_key": {"type": "string", "maxLength": 256},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "security_scan_status": {"type": "string", "enum": ["not_applicable", "pending", "passed", "blocked", "failed"]},
    "privacy_classification": {"type": "string", "enum": ["public", "personal", "sensitive", "highly_sensitive"]}
  }
}