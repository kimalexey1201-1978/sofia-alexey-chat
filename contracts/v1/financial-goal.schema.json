{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/financial-goal.schema.json",
  "title": "Sofia Financial Goal",
  "description": "Savings or funding goal; contribution plan is informational and does not authorize transfers.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_id", "principal_id", "name", "target_amount", "currency", "status", "created_at"],
  "properties": {
    "goal_id": { "type": "string", "format": "uuid" },
    "principal_id": { "type": "string", "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "target_amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$", "maxLength": 40 },
    "current_confirmed_amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$", "maxLength": 40 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "target_date": { "type": "string", "format": "date" },
    "contribution_plan_ref": { "type": "string", "maxLength": 256 },
    "status": { "type": "string", "enum": ["active", "paused", "achieved", "cancelled", "archived"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
