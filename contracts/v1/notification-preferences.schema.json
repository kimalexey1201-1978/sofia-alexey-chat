{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/notification-preferences.schema.json",
  "title": "Sofia Notification Preferences",
  "description": "User-controlled notification channels, quiet hours, privacy previews, and frequency limits.",
  "schema_version": "1.0.0",
  "contract_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["principal_id", "timezone", "quiet_hours", "category_settings", "updated_at"],
  "properties": {
    "principal_id": { "type": "string", "maxLength": 128 },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "quiet_hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "start_local", "end_local"],
      "properties": {
        "enabled": { "type": "boolean" },
        "start_local": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end_local": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
        "critical_categories_allowed": {
          "type": "array",
          "items": { "type": "string", "enum": ["security", "system"] },
          "uniqueItems": true
        }
      }
    },
    "category_settings": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "allowed_channels"],
        "properties": {
          "enabled": { "type": "boolean" },
          "allowed_channels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["in_app", "android", "web_push", "email", "sms", "wearable", "vehicle", "smart_display"]
            },
            "uniqueItems": true
          },
          "sound_enabled": { "type": "boolean" },
          "vibration_enabled": { "type": "boolean" },
          "generic_preview_only": { "type": "boolean", "default": true },
          "max_per_hour": { "type": "integer", "minimum": 0, "maximum": 100 },
          "max_per_day": { "type": "integer", "minimum": 0, "maximum": 500 }
        }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
