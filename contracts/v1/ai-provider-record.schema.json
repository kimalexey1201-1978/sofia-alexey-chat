{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/ai-provider-record.schema.json",
  "title": "Sofia AI Provider Record v1",
  "description": "Registry record for an approved AI inference provider adapter. Provider claims are not proof of capability or privacy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_id",
    "schema_version",
    "adapter_id",
    "adapter_version",
    "status",
    "endpoint_ref",
    "credential_ref",
    "approved_data_classes",
    "capabilities",
    "health_state",
    "policy_version"
  ],
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9._:-]+$"
    },
    "schema_version": {
      "const": "1.0"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "enum": [
        "pending_validation",
        "validated",
        "active",
        "suspended",
        "disabled",
        "revoked"
      ]
    },
    "endpoint_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Reference to endpoint configuration; never a credential."
    },
    "credential_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Opaque secret-store reference, never the credential value."
    },
    "approved_data_classes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "public",
          "internal",
          "personal",
          "sensitive"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "text_generation",
          "structured_output",
          "tool_call_proposals",
          "vision",
          "audio_input",
          "audio_output",
          "streaming",
          "embeddings",
          "translation",
          "reasoning"
        ]
      }
    },
    "health_state": {
      "enum": [
        "unknown",
        "healthy",
        "degraded",
        "unavailable",
        "circuit_open"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "processing_regions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "retention_mode": {
      "enum": [
        "verified_zero_retention",
        "verified_limited_retention",
        "provider_standard",
        "unknown"
      ]
    },
    "training_use": {
      "enum": [
        "verified_no_training",
        "verified_training_opt_out",
        "training_may_occur",
        "unknown"
      ]
    },
    "verified_capability_refs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "last_health_check_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_validation_at": {
      "type": "string",
      "format": "date-time"
    },
    "quota_ref": {
      "type": "string",
      "maxLength": 256
    },
    "disabled_reason": {
      "type": "string",
      "maxLength": 500
    }
  }
}
