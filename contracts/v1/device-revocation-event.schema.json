{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/device-revocation-event.schema.json",
  "title": "Sofia AI Device Revocation Event v1",
  "description": "Auditable owner- or policy-authorized revocation/suspension event with downstream invalidation tracking.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "device_ref", "target_type", "action", "reason_code", "issued_at", "actor_ref", "propagation"],
  "properties": {
    "event_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "device_ref": {"type": "string", "minLength": 8, "maxLength": 256},
    "credential_ref": {"type": "string", "maxLength": 256},
    "target_type": {"type": "string", "enum": ["device", "credential", "pairing_transaction"]},
    "action": {"type": "string", "enum": ["suspend", "revoke", "mark_compromised", "retire"]},
    "reason_code": {"type": "string", "enum": ["owner_lost_device", "suspected_theft", "suspected_compromise", "credential_rotation", "ownership_dispute", "policy_violation", "owner_request", "other"]},
    "actor_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "issued_at": {"type": "string", "format": "date-time"},
    "effective_at": {"type": "string", "format": "date-time"},
    "approval_ref": {"type": "string", "maxLength": 256},
    "propagation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_manager", "status"],
        "properties": {
          "target_manager": {"type": "string", "enum": ["SDM", "IAM", "CPR", "SSM", "ES", "AUDIT", "ADAPTER_SESSIONS", "COMMAND_QUEUE"]},
          "status": {"type": "string", "enum": ["pending", "confirmed", "failed", "not_applicable"]},
          "result_ref": {"type": "string", "maxLength": 256},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "correlation_id": {"type": "string", "maxLength": 128}
  }
}