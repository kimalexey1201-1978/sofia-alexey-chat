{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.local/contracts/v1/consent-record.schema.json",
  "title": "Sofia AI Consent Record",
  "description": "Versioned, purpose-bound consent state. Does not replace OS permissions, authentication or legal basis.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "consent_id", "principal_id", "purpose_id", "data_categories", "scope", "policy_version", "status", "granted_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "consent_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "principal_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "purpose_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "data_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["conversation", "memory", "microphone", "camera", "location", "wearable_sensor", "device_state", "external_provider_processing", "diagnostics"] }
    },
    "scope": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": { "type": "string", "enum": ["granted", "denied", "revoked", "expired", "superseded"] },
    "granted_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": "string", "format": "date-time" },
    "collection_channel": { "type": "string", "enum": ["app_ui", "voice_confirmation", "system_settings", "administrator_policy"] },
    "evidence_reference": { "type": "string", "maxLength": 1000 }
  }
}