{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sofia.ai/contracts/v1/social-publish-request.schema.json",
  "title":"Sofia Social Publish Request",
  "description":"Exact content, destination, visibility, and operation proposed for user-confirmed platform submission.",
  "schema_version":"1.0.0",
  "contract_version":"1.0.0",
  "type":"object",
  "additionalProperties":false,
  "required":["publish_request_id","connection_id","platform_id","operation","content_asset_ids","content_hash_sha256","purpose","requested_at"],
  "properties":{
    "publish_request_id":{"type":"string","format":"uuid"},
    "connection_id":{"type":"string","format":"uuid"},
    "platform_id":{"type":"string","maxLength":160},
    "operation":{"type":"string","enum":["create_draft","schedule","publish","delete_post"]},
    "content_asset_ids":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","format":"uuid"}},
    "content_hash_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "caption":{"type":"string","maxLength":10000},
    "hashtags":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"string","maxLength":128}},
    "cover_asset_id":{"type":"string","format":"uuid"},
    "visibility":{"type":"string","enum":["private","unlisted","public","friends","platform_default"]},
    "scheduled_at":{"type":"string","format":"date-time"},
    "purpose":{"type":"string","minLength":1,"maxLength":256},
    "consent_ref":{"type":"string","maxLength":256},
    "authority_envelope_ref":{"type":"string","maxLength":256},
    "policy_decision_ref":{"type":"string","maxLength":256},
    "approval_required":{"type":"boolean","const":true},
    "approval_ref":{"type":"string","maxLength":256},
    "requested_at":{"type":"string","format":"date-time"}
  }
}
