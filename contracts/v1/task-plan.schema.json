{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia-ai.example/contracts/v1/task-plan.schema.json",
  "title": "Sofia AI Task Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "task_id",
    "plan_version",
    "created_at",
    "owner_goal",
    "success_criteria",
    "steps",
    "autonomy_level",
    "resource_policy",
    "policy_version",
    "status"
  ],
  "properties": {
    "plan_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "plan_version": { "type": "integer", "minimum": 1 },
    "supersedes_plan_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "owner_goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "success_criteria": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "assumptions": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 1000 } },
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": { "$ref": "task-plan-step.schema.json" }
    },
    "autonomy_level": { "enum": ["A0", "A1", "A2", "A3", "A4"] },
    "resource_policy": { "enum": ["FREE_ONLY", "OWNER_APPROVED_PAID_EXCEPTION"] },
    "estimated_duration_seconds": { "type": "integer", "minimum": 0 },
    "deadline_at": { "type": "string", "format": "date-time" },
    "authority_envelope_ref": { "type": "string", "maxLength": 256 },
    "owner_approval_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 256 } },
    "risk_tier": { "enum": ["R0", "R1", "R2", "R3", "unknown"] },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": { "enum": ["draft", "awaiting_owner_approval", "approved", "running", "paused", "blocked", "completed", "partially_completed", "failed", "cancelled", "superseded"] }
  }
}
