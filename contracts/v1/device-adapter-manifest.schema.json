{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.ai/contracts/v1/device-adapter-manifest.schema.json",
  "title": "Sofia AI Device Adapter Manifest v1",
  "description": "Versioned declaration for a device adapter. It is untrusted metadata and never grants installation approval, device trust or capability permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_id", "version", "publisher_id", "artifact_digest", "sdk_contract_version", "runtime", "platforms", "device_classes", "capability_refs", "permissions", "data_classes", "resources"],
  "properties": {
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$", "maxLength": 160},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"},
    "publisher_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "artifact_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "signature_ref": {"type": "string", "maxLength": 256},
    "sdk_contract_version": {"type": "string", "const": "1.0.0"},
    "runtime": {"type": "string", "enum": ["android_service", "isolated_process", "wasm", "container", "remote_service", "platform_api"]},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["android", "ios", "windows", "linux", "macos", "embedded", "cloud"]}},
    "device_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["smartphone", "tablet", "smartwatch", "fitness_band", "smart_glasses", "headphones", "audio_device", "camera", "sensor", "display", "computer", "vehicle_system", "smart_home_hub", "smart_lock", "climate_device", "lighting_device", "security_device", "other"]}},
    "transports": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["android_api", "ios_api", "bluetooth_le", "wifi_lan", "usb", "matter", "vendor_cloud", "usb_serial", "other"]}},
    "capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 256}},
    "permissions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["permission_id", "purpose", "required"], "properties": {"permission_id": {"type": "string", "maxLength": 180}, "purpose": {"type": "string", "minLength": 1, "maxLength": 500}, "required": {"type": "boolean"}, "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000}}}},
    "data_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["public", "user_content", "personal_data", "sensitive_data", "credentials", "device_telemetry"]}},
    "network_egress_allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 253}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["max_memory_mb", "max_execution_ms", "max_concurrency"], "properties": {"max_memory_mb": {"type": "integer", "minimum": 1, "maximum": 65536}, "max_execution_ms": {"type": "integer", "minimum": 1, "maximum": 3600000}, "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 100}, "max_network_bytes": {"type": "integer", "minimum": 0}, "requires_network": {"type": "boolean"}}},
    "supports_cancellation": {"type": "boolean"},
    "supports_reconciliation": {"type": "boolean"},
    "health_check_ref": {"type": "string", "maxLength": 256},
    "declared_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}