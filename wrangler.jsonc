{
  "name": "sofia",
  "main": "./_worker.js",
  "compatibility_date": "2026-11-18",
  "previews": {},
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": false
    },
    "issues": {
      "enabled": false
    }
  }
}
